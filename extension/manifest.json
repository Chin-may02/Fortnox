{
    "manifest_version": 3,
    "name": "FORTNOX",
    "version": "0.2.0",
    "description": "ML-based Chrome extension for web security and email phishing detection.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "webNavigation"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.office.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "page_permission_monitor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "warning_styles.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://mail.google.com/*"
            ],
            "js": [
                "gmail_content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    }
}
